# deps + build output (rebuilt by setup/update scripts)
node_modules/
dist/
build/
# workspace members install via the root lockfile only — nested lockfiles
# caused broken Windows installs (npm/cli#4828: missing rollup win32 binary)
backend/package-lock.json
frontend/package-lock.json

# secrets — NEVER commit (each member has their own .env)
.env
.env.local
*.pem
*.key

# local runtime data (each member's own DB/scans)
screenshots/
reports/
logs/
db_data/
*.sqlite
*.db

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log
