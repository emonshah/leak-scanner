# === leak-scanner production env (single-port origin behind Cloudflare Tunnel) ===
# Copy this file to the server as /opt/leak-scanner/backend/.env  (it is in .gitignore).
# Edit the CHANGE_ME / secret values. DO NOT commit real secrets.
# Note: deploy/deploy.sh writes this file for you (with your input secrets).

# --- Server ---
PORT=3000
NODE_ENV=production
# The public tunnel domain. Drives the CORS allowlist in backend/src/index.ts
# (only this origin + localhost dev origins are allowed with credentials).
# If you serve over HTTPS, set the matching Secure-cookie flag below.
PUBLIC_APP_URL=https://app.emonshah.com

# --- MySQL (LOCAL ONLY on the server — never exposed through the tunnel) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=leak_scanner
DB_PASS=CHANGE_ME
DB_NAME=leak_scanner

# --- Auth ---
# Long random string signing stateless HMAC session cookies.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=CHANGE_ME_64_HEX

# First-boot seed admin. Used ONLY when the users table is empty; afterwards
# admins invite team members via /api/users (UI: Settings -> Users).
ADMIN_EMAIL=admin@emonshah.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=CHANGE_ME_12_PLUS   # change after first login (user can self-change at /api/auth/password)

# --- Auth cookies ---
# HTTPS (the tunnel) requires Secure cookies so the browser sends them over TLS.
COOKIE_SECURE=1

# --- Scanner ---
SCAN_CONCURRENCY=3
SCAN_TIMEOUT_MS=300000
SCAN_MAX_PAGES=12
# SSRF guard: blocks localhost/private/metadata on every scanned target URL and
# redirect hop. NEVER set to 1 on a live instance.
SCAN_ALLOW_PRIVATE=0

# --- Browser ---
HEADFUL=0

# --- Qwen API (optional) ---
QWEN_BASE_URL=https://qwen.emonshah.com
QWEN_MODEL=qwen2.5:3b
QWEN_TIMEOUT_MS=60000

# --- Updates (one-click updater stays OFF on the server; update with
#     git pull && npm run build && systemctl restart leak-scanner) ---
ENABLE_UPDATER=0
GITHUB_REPO=emonshah/leak-scanner
