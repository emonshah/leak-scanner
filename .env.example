# Copy this file to backend/.env, then fill in your own values.
# The backend reads backend/.env (DB + admin are configured there, no setup page).
# NEVER commit backend/.env — it holds passwords and secrets.

# Database (MySQL via XAMPP, port 3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=leak_scanner
DB_USER=root
DB_PASS=

# Auth
AUTH_SECRET=change-to-a-long-random-string-min-16-chars
ADMIN_EMAIL=admin@local.test
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me-now-8-plus-chars

# Server
PUBLIC_APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=production

# Scan settings (adjust as needed)
SCAN_CONCURRENCY=3
SCAN_TIMEOUT_MS=300000
SCAN_MAX_PAGES=12
HEADFUL=0
SCAN_ALLOW_PRIVATE=0

# Qwen API (optional)
QWEN_BASE_URL=https://qwen.emonshah.com
QWEN_MODEL=qwen2.5:3b
QWEN_TIMEOUT_MS=60000

# Updates (public GitHub repo for release checks; one-click runs git pull + npm run build, needs ENABLE_UPDATER=1)
GITHUB_REPO=emonshah/leak-scanner
ENABLE_UPDATER=0
