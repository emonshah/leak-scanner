# Database
DB_NAME=leak_scanner
DB_USER=scanner
DB_PASSWORD=scannerpass
DB_ROOT_PASSWORD=rootpass
DB_HOST=localhost
DB_PORT=3306

# Backend
JWT_SECRET=changeme-secret-change-in-production
ADMIN_EMAIL=admin@scanner.local
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin
SCRIPTS_DIR=./backend/scripts
SCREENSHOTS_DIR=./screenshots

# Qwen API (optional)
QWEN_API_KEY=
QWEN_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aiservice/text-generation

# Server
PORT=3000
NODE_ENV=development

# Updates (public GitHub repo for release checks; one-click runs git pull + npm run build, needs ENABLE_UPDATER=1)
GITHUB_REPO=emonshah/leak-scanner
ENABLE_UPDATER=0
