# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=leak_scanner
DB_USER=leak_scanner
DB_PASS=changeme

# Auth
AUTH_SECRET=changeme-64-hex-chars
ADMIN_EMAIL=admin@local.test
ADMIN_NAME=Admin
ADMIN_PASSWORD=changeme123

# Server
PUBLIC_APP_URL=http://localhost:3000
# 1 when served over HTTPS (e.g. Cloudflare Tunnel) — the wizard sets this for you
COOKIE_SECURE=0
PORT=3000
NODE_ENV=development

# Scan settings
SCAN_CONCURRENCY=3
SCAN_TIMEOUT_MS=300000
SCAN_MAX_PAGES=12
HEADFUL=0
SCAN_ALLOW_PRIVATE=0

# Qwen API (optional)
QWEN_BASE_URL=https://qwen.emonshah.com
QWEN_MODEL=qwen2.5:3b
QWEN_TIMEOUT_MS=60000

# Updates (one-click runs git pull + npm run build; needs ENABLE_UPDATER=1)
GITHUB_REPO=emonshah/leak-scanner
ENABLE_UPDATER=0
