{
  "name": "leak-scanner-frontend",
  "version": "1.2.1",
  "description": "Conversion leak scanner dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/ensure-frontend-deps.js",
    "dev": "vite --port 5173",
    "prebuild": "node ../scripts/ensure-frontend-deps.js",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.436.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.0"
  }
}
